{
  "name": "discord-food-ordering-bot",
  "version": "1.0.0",
  "description": "Discord bot for daily food ordering and payment management",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "setup": "node scripts/setupSupabase.js",
    "setup-supabase": "node scripts/setupSupabase.js",
    "reset-menus": "node scripts/resetDailyMenus.js",
    "deploy": "node src/utils/deployCommands.js",
    "clear-commands": "node scripts/clearCommands.js",
    "test-summary": "node scripts/testSummary.js",
    "test-payment": "node scripts/testPaymentNotification.js",
    "test-kafka": "node test/kafkaIntegrationTest.js",
    "test-safe": "KAFKA_ENABLED=false node test/kafkaIntegrationTest.js",
    "start-safe": "KAFKA_ENABLED=false node src/index.js",
    "test-reliable": "node scripts/test-reliable-messaging.js",
    "web:dev": "cd web && next dev -p 3001",
    "web:build": "cd web && next build",
    "web:start": "cd web && next start -p 3001",
    "web:lint": "cd web && next lint",
    "web:setup": "cd web && npm install"
  },
  "keywords": [
    "discord",
    "bot",
    "food",
    "ordering",
    "payment"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.49.8",
    "@supabase/auth-helpers-nextjs": "^0.8.7",
    "@supabase/auth-helpers-react": "^0.4.2",
    "@supabase/auth-ui-react": "^0.4.6",
    "@supabase/auth-ui-shared": "^0.1.8",
    "axios": "^1.6.0",
    "discord.js": "^14.14.1",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "kafkajs": "^2.2.4",
    "moment": "^2.29.4",
    "moment-timezone": "^0.5.43",
    "next": "^14.0.0",
    "node-cron": "^3.0.3",
    "pg": "^8.16.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sqlite3": "^5.1.6",
    "uuid": "^11.1.0",
    "tailwindcss": "^3.3.0",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.31"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "@types/node": "^20.8.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "eslint": "^8.52.0",
    "eslint-config-next": "^14.0.0"
  }
}
